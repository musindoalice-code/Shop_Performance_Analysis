{
  "datasets": [
    {
      "name": "monthly_revenue",
      "displayName": "Monthly Revenue Trend",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('month', o.OrderDate) AS YearMonth,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS RecognisedRevenue\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "WHERE\n",
        "  o.OrderDate IS NOT NULL\n",
        "GROUP BY\n",
        "  DATE_TRUNC('month', o.OrderDate)\n",
        "ORDER BY\n",
        "  YearMonth"
      ]
    },
    {
      "name": "revenue_by_city",
      "displayName": "Revenue by City",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(c.City, 'Unknown') AS City,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS RecognisedRevenue\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_customers c\n",
        "      ON o.CustomerID = c.CustomerID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "GROUP BY\n",
        "  COALESCE(c.City, 'Unknown')\n",
        "ORDER BY\n",
        "  RecognisedRevenue DESC"
      ]
    },
    {
      "name": "top_products",
      "displayName": "Top 10 Products by Revenue",
      "queryLines": [
        "SELECT\n",
        "  pr.ProductName,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS Revenue,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN o.Quantity > 0 THEN o.Quantity\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS Units\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "GROUP BY\n",
        "  pr.ProductName\n",
        "ORDER BY\n",
        "  Revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "revenue_by_category",
      "displayName": "Revenue by Category",
      "queryLines": [
        "SELECT\n",
        "  pr.Category,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS Revenue,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN o.Quantity > 0 THEN o.Quantity\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS Units\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "GROUP BY\n",
        "  pr.Category\n",
        "ORDER BY\n",
        "  Revenue DESC"
      ]
    },
    {
      "name": "kpi_metrics",
      "displayName": "KPI Metrics",
      "queryLines": [
        "SELECT\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS TotalRecognisedRevenue,\n",
        "  COUNT(DISTINCT o.OrderID) AS TotalOrders,\n",
        "  COUNT(DISTINCT\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        o.OrderID\n",
        "    END\n",
        "  ) AS RecognisedOrders,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  )\n",
        "    / NULLIF(\n",
        "      COUNT(DISTINCT\n",
        "        CASE\n",
        "          WHEN\n",
        "            o.Status = 'Completed'\n",
        "            AND p.PaymentStatus = 'Paid'\n",
        "          THEN\n",
        "            o.OrderID\n",
        "        END\n",
        "      ),\n",
        "      0\n",
        "    ) AS AvgOrderValue\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_customers c\n",
        "      ON o.CustomerID = c.CustomerID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID"
      ]
    },
    {
      "name": "revenue_by_segment",
      "displayName": "Revenue by Customer Segment",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(c.CustomerSegment, 'Unknown') AS CustomerSegment,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        o.Status = 'Completed'\n",
        "        AND p.PaymentStatus = 'Paid'\n",
        "      THEN\n",
        "        CASE\n",
        "          WHEN o.Quantity > 0 THEN o.Quantity\n",
        "          ELSE 0\n",
        "        END\n",
        "          * pr.UnitPrice\n",
        "          * (1 - o.Discount)\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS RecognisedRevenue\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_customers c\n",
        "      ON o.CustomerID = c.CustomerID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "GROUP BY\n",
        "  COALESCE(c.CustomerSegment, 'Unknown')\n",
        "ORDER BY\n",
        "  RecognisedRevenue DESC"
      ]
    },
    {
      "name": "order_status",
      "displayName": "Order Status Distribution",
      "queryLines": [
        "SELECT\n",
        "  o.Status,\n",
        "  COUNT(*) AS OrderCount,\n",
        "  ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 1) AS Pct\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "GROUP BY\n",
        "  o.Status\n",
        "ORDER BY\n",
        "  OrderCount DESC"
      ]
    },
    {
      "name": "payment_fail_rate",
      "displayName": "Payment Failure Rate by Method",
      "queryLines": [
        "SELECT\n",
        "  COALESCE(o.PaymentMethod, 'Unknown') AS PaymentMethod,\n",
        "  ROUND(\n",
        "    AVG(\n",
        "      CASE\n",
        "        WHEN p.PaymentStatus = 'Failed' THEN 1.0\n",
        "        ELSE 0.0\n",
        "      END\n",
        "    )\n",
        "      * 100,\n",
        "    1\n",
        "  ) AS FailRatePct\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "GROUP BY\n",
        "  COALESCE(o.PaymentMethod, 'Unknown')\n",
        "ORDER BY\n",
        "  FailRatePct DESC"
      ]
    },
    {
      "name": "discount_band_aov",
      "displayName": "Avg Order Value by Discount Band",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN o.Discount = 0 THEN '0%'\n",
        "    WHEN o.Discount <= 0.1 THEN '1-10%'\n",
        "    WHEN o.Discount <= 0.2 THEN '11-20%'\n",
        "    ELSE '21+%'\n",
        "  END AS DiscountBand,\n",
        "  ROUND(\n",
        "    AVG(\n",
        "      CASE\n",
        "        WHEN o.Quantity > 0 THEN o.Quantity\n",
        "        ELSE 0\n",
        "      END\n",
        "        * pr.UnitPrice\n",
        "        * (1 - o.Discount)\n",
        "    ),\n",
        "    2\n",
        "  ) AS AvgOrderValue\n",
        "FROM\n",
        "  shop_performance.shop_performance_data.shop_orders o\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_products pr\n",
        "      ON o.ProductID = pr.ProductID\n",
        "    LEFT JOIN shop_performance.shop_performance_data.shop_payments p\n",
        "      ON o.OrderID = p.OrderID\n",
        "WHERE\n",
        "  o.Status = 'Completed'\n",
        "  AND p.PaymentStatus = 'Paid'\n",
        "GROUP BY\n",
        "  CASE\n",
        "    WHEN o.Discount = 0 THEN '0%'\n",
        "    WHEN o.Discount <= 0.1 THEN '1-10%'\n",
        "    WHEN o.Discount <= 0.2 THEN '11-20%'\n",
        "    ELSE '21+%'\n",
        "  END\n",
        "ORDER BY\n",
        "  DiscountBand"
      ]
    }
  ],
